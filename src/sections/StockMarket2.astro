const CodEmpresasjson = await fetch(
    "http://localhost:8080/cotizaciones/BuscarMisEmpresas",
);
const CodEmpresas = await CodEmpresasjson.json();
Empresas.forEach((empresa, index) => {
    if (CodEmpresas[index]) {
        empresa.Abreviacion = CodEmpresas[index]; // Asignar el código a la posición correspondiente
    }
});

const fetchPromises = Empresas.map(async (empresa) => {
    if (empresa.Abreviacion) {
        const response = await fetch(
            `http://localhost:8080/empresas/${empresa?.Abreviacion}`,
        );
        const data = await response.json();
        if (data.codempresa === empresa.Abreviacion) {
            empresa.Nombre = data.empresaNombre; // Actualiza el nombre
            empresa.cantidadAcciones = data.cantidadAcciones;
        }
       /*  console.log(Empresas); */
        return data; // Puedes almacenar los datos si los necesitas
    } else {
        console.warn(
            `La empresa ${empresa.Nombre} no tiene una Abreviacion asignada.`,
        );
        return null;
    }
});
const resultados = await Promise.all(fetchPromises);

