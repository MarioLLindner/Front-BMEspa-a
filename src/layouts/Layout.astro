---
import Header from "@components/HeaderComp.astro";
import Footer from "@sections/Footer.astro";

interface Props {
	description: string;
	title: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html >
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body>
		<Header />
		<div class="min-h-screen bg-gray-100 flex flex-col">
			<slot />
			<Footer />
		</div>
	</body>
	<style is:global>
		@font-face {
			font-family: "Space Grotesk";
			src: url("/fonts/SpaceGrotesk-VariableFont_wght.ttf") format("ttf");
			font-weight: 100 900;
			font-style: normal;
			font-display: swap;
		}
		@font-face {
			font-family: "Trois Mille";
			src: url("fonts/Trois Mille TRIAL Bold 15.woff2") format("woff2");
			font-weight: 700;
			font-style: normal;
			font-display: swap;
		}
		@font-face {
			font-family: "Trois Mille";
			src: url("fonts/Trois Mille TRIAL Black 15.woff2") format("woff2");
			font-weight: 900;
			font-style: normal;
			font-display: swap;
		}
		html {
			font-family: system-ui, sans-serif;
			background: #fff;
		}
	</style>
</html>
