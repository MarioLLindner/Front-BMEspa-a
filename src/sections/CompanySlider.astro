const CodIndicesjson = await fetch("http://localhost:8080/cotizacionIndice/BuscarMisIndices")
const CodIndices = await CodIndicesjson.json()

IndiceBursatil.forEach((Indice, index) => {
    if (CodIndices[index]) {
        Indice.Abreviacion = CodIndices[index]; // Asignar el código a la posición correspondiente
    }
});

const fetchPromises = IndiceBursatil.map(async (indice) => {
    if (indice.Abreviacion) {
        const response = await fetch(`http://localhost:8080/indices/Detalles/${indice.Abreviacion}`);
        const data = await response.json();
        if (data.codigoIndice === indice.Abreviacion) {
            indice.Nombre = data.nombreIndice;
            ;}
        return data; // Puedes almacenar los datos si los necesitas
    } else {
        /* console.warn(`La empresa ${indice.Nombre} no tiene una Abreviacion asignada.`); */
        return null;
    }
});
const resultados = await Promise.all(fetchPromises)


