---
import LanguageSwitcher from "@components/lenguageSwitcher/lenguageSwitcher";
import { Texto } from "@components/Textos/Texto";
import { MapPin, Phone, Mail, Clock } from "lucide-react";

const companies = [
  "Apple Inc.",
  "Tesla, Inc.",
  "JPMorgan Chase & Co.",
  "Roche Holding AG",
  "Shell plc",
  "NVIDIA Corporation",
  "Coca-Cola Company",
];

const exchanges = [
  "Canada",
  "USA",
  "Turkey",
  "Argentina",
  "Brazil",
  "Japan",
  "China",
  "England",
  "Netherlands",
  "France",
  "Germany",
  "Australia",
  "Italy",
  "Norway",
  "Russia",
];

---

<footer class="bg-gray-900 text-white py-12">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Company List -->
      <div class="mb-8">
        <h3 class="text-lg font-semibold mb-3 text-gray-100">
          <Texto client:only="react" props="ListadeCompanias"/>
        </h3>
        <ul class="grid grid-cols-2 md:grid-cols-3 gap-2">
          {
            companies.map((company) => (
              <li class="text-gray-300 text-sm hover:text-white transition-colors">
                {company}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Global Exchanges -->
      <div class="mb-8">
        <h3 class="text-lg font-semibold mb-3 text-gray-100">
          <Texto client:only="react" props="GlobalExchangeNetwork"/>
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2">
          {
            exchanges.map((country) => (
              <span class="text-gray-300 text-sm hover:text-white transition-colors">
                {country}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Contact Information -->
      <div class="mb-8">
        <h3 class="text-lg font-semibold mb-3 text-gray-100">
          <Texto client:only="react" props="ContactInformation"/>
        </h3>
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-gray-300">
            <MapPin className="w-4 h-4" />
            <span class="text-sm"
              >Plaza de la Lealtad, 1, 28014 
              <Texto client:only="react" props="MadridSpain"/>
              </span
            >
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <Phone className="w-4 h-4" />
            <span class="text-sm">+34 91 589 1000</span>
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <Mail className="w-4 h-4" />
            <span class="text-sm">info@bme.es</span>
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <Clock className="w-4 h-4" />
            <span class="text-sm">
              <Texto client:only="react" props="TradingHours"/>: 09:00 - 17:30 CET
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="border-t border-gray-700 mt-8 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="text-gray-400 text-sm mb-4 md:mb-0">
          © {new Date().getFullYear()}
          ("BME - Bolsas y Mercados Españoles. 
          <Texto client:only="react" props="Allrightsreserved"/>
          .")
        </div>
        <div class="flex gap-6">
          <a href="#" class="text-gray-400 hover:text-white text-sm"
            >
            <Texto client:only="react" props="PrivacyPolicy"/>  
          </a>
          <a href="#" class="text-gray-400 hover:text-white text-sm"
            >
            <Texto client:only="react" props="TermsofService"/>
            </a
          >
          <a href="#" class="text-gray-400 hover:text-white text-sm"
            >
            <Texto client:only="react" props="CookiePolicy"/>
            </a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
