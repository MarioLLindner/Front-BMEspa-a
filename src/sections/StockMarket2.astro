            <Texto client:only="react" props="participacion"/>
        </div>
        <div class="">
            <ParticipacionDeEmpresas client:only="react" empresas={Empresas}/>
        </div>
    </div>
</section>

<style>

    #company-container {
        transition: transform 700ms ease;
        &.slide-in {
            transform: translateX(-102%);
        }
    }

</style>

<script>
import { Empresas } from "./StockMarket2.astro";


    export let EmpresaActual = {};

    const $container = document.querySelector(
        "#company-container",
    ) as HTMLElement;
    const $list = document.querySelector("#company-list") as HTMLElement;
    const $buttons = $list.querySelectorAll("button");
    const $closeButton = document.querySelector("#close-button") as HTMLElement;
    const $ConteinerDetalle = document.querySelector(
        ".EmpDetalle",
    ) as HTMLElement;

    $buttons.forEach((button, index) => {
        button.addEventListener("click", (e) => {
            EmpresaActual = Empresas[index];
            console.log(EmpresaActual);
            $container.classList.add("slide-in");
            $ConteinerDetalle.classList.add("display-block");
        });
    });

    $closeButton.addEventListener("click", (e) => {
        $container.classList.remove("slide-in");
        $ConteinerDetalle.classList.remove("display-block");
    });
</script>
